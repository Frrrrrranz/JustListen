<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    tools:context=".MainActivity">

    <com.example.filmplayer.DiscCarouselView
        android:id="@+id/discCarouselView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/emptyLibraryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="34dp"
            android:background="@drawable/empty_library_card_background"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/empty_library_title"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/empty_library_description"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/emptyLibraryAction"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/empty_library_action_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="132dp"
                android:paddingHorizontal="20dp"
                android:text="@string/empty_library_action"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="serif"
        android:text="@string/home_title"
        android:textColor="@color/text_primary"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/scanStatus"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="94dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="serif"
        android:gravity="end"
        android:maxLines="2"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/selectedSongTitle"
        android:layout_width="136dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="176dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="serif"
        android:gravity="end"
        android:maxLines="2"
        android:textColor="@color/text_muted"
        android:textSize="20sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/addDiscButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/add_button_background"
        android:contentDescription="@string/add_disc"
        android:elevation="8dp"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/text_muted"
        android:textSize="32sp" />
</FrameLayout>
